# ==================== SICOOB CONFIG ====================
SICOOB_CLIENT_ID=seu_client_id_aqui
SICOOB_CERTIFICADO=C:/caminho/para/certificado.pem
SICOOB_CHAVE_PRIVADA=C:/caminho/para/chave_privada.key
SICOOB_NUMERO_CLIENTE=123456        # número do convênio/cliente no SICOOB
SICOOB_NUMERO_CONTA_CORRENTE=12345  # número da conta corrente no SICOOB

# true para sandbox (testes, sem cobrança real), false para produção
SICOOB_SANDBOX=true

SICOOB_TIMEOUT=30

# Segredo para validar assinatura HMAC-SHA256 do webhook Sicoob.
# Deixar vazio para desabilitar validação (modo dev/sem webhook configurado).
SICOOB_WEBHOOK_SECRET=

# ==================== VHSYS CONFIG (somente leitura) ====================
# Usado apenas para pré-preencher formulário de emissão via pedido VHSys.
# Deixar em branco para desabilitar a integração VHSys.
VHSYS_BASE_URL=https://api.vhsys.com.br/v2
VHSYS_ACCESS_TOKEN=
VHSYS_SECRET_TOKEN=
